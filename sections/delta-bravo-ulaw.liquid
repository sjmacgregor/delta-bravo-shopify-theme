              <stop offset="0%" stop-color="#E02424"/>
              <stop offset="100%" stop-color="#B91C1C"/>
            </linearGradient>
            <linearGradient id="ulawChevRed" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#EF4444"/>
              <stop offset="100%" stop-color="#C81E1E"/>
            </linearGradient>
